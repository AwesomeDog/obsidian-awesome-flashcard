{
	"name": "obsidian-awesome-flashcard",
	"version": "0.1.3",
	"description": "Handy Anki integration for Obsidian.",
	"main": "main.js",
	"engines": {
		"node": ">=24.15.0"
	},
	"packageManager": "npm@12.0.2",
	"scripts": {
		"clean": "del-cli -f main.js styles.css data.json build",
		"dev": "node esbuild.config.mjs",
		"lint": "oxlint --deny-warnings src tests scripts *.mjs",
		"typecheck": "tsc --noEmit",
		"test": "jest --ci",
		"build": "npm run clean && npm run typecheck && node esbuild.config.mjs production",
		"check": "npm run lint && npm test -- --runInBand && npm run typecheck",
		"deploy": "node scripts/deploy.mjs",
		"release": "npm run build && mkdir build && shx cp main.js styles.css manifest.json build",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@swc/core": "^1.16.1",
		"@swc/jest": "^0.2.39",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.3.0",
		"del-cli": "^7.0.0",
		"esbuild": "^0.28.2",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"obsidian": "^1.13.1",
		"oxlint": "^1.80.0",
		"shx": "^0.4.0",
		"typescript": "^7.0.2"
	}
}
